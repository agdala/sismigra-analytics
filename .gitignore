# Dados locais: nunca versionar microdados brutos ou derivados
data/
*.csv
*.zip
*.parquet
*.duckdb
*.duckdb.wal
!tests/fixtures/*.csv
# Agregados protegidos (k = 5): única saída de dados versionada, fonte oficial dos painéis
!publicacao/*.csv
# Tabelas de referência e revisão (sem microdados) são versionadas
!ref/*.csv
!docs/revisao/*.csv

# Saídas geradas. São versionados de propósito: o inventário da Etapa 0 e o
# relatório de qualidade mais recente (só contagens, sem microdados).
reports/*
!reports/inventario/
reports/inventario/*
!reports/inventario/inventario.md
!reports/inventario/inventario.json
!reports/qualidade/
reports/qualidade/*
!reports/qualidade/relatorio_qualidade.md
!reports/qualidade/relatorio_qualidade.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# dbt: artefatos gerados (o site de docs é publicado pelo CI) e cópia das seeds de ref/
dbt/target/
dbt/logs/
dbt/seeds/
dbt/.user.yml
